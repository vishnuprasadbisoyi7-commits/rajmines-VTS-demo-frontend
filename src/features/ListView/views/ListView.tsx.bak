import React, { useState, useMemo } from 'react';
import { useNavigate } from 'react-router';
import {
  Download,
  ChevronDown,
  Search,
  Check,
  Radio,
  Navigation,
  ExternalLink,
} from 'lucide-react';
import type { VehicleTelemetryViewDto } from '@/shared/types/vts.types';
import { useLiveTelemetry } from '@/shared/hooks/useLiveTelemetry';
import { ROUTES } from '@/shared/constants/app.constants';

interface ColumnDef {
  key: string;
  label: string;
  visible: boolean;
}

function formatPacketDateTime(dateStr?: string, timeStr?: string, createdAt?: string): string {
  if (dateStr && timeStr && dateStr.length === 8 && timeStr.length === 6) {
    const d = dateStr.slice(0, 2);
    const m = dateStr.slice(2, 4);
    const y = dateStr.slice(4, 8);
    const hh = timeStr.slice(0, 2);
    const mm = timeStr.slice(2, 4);
    const ss = timeStr.slice(4, 6);
    return `${d}/${m}/${y} ${hh}:${mm}:${ss}`;
  }
  if (createdAt) {
    try {
      const date = new Date(createdAt);
      if (!isNaN(date.getTime())) {
        return date.toLocaleString();
      }
    } catch {}
  }
  return 'Just now';
}

function formatCreatedAt(createdAt?: string): string {
  if (!createdAt) return 'Just now';
  try {
    const d = new Date(createdAt);
    if (!isNaN(d.getTime())) {
      return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    }
  } catch {}
  return createdAt;
}

export const ListView: React.FC = () => {
  const navigate = useNavigate();
  const { recentTelemetry, isLoading, isLiveConnected, lastSyncTime } = useLiveTelemetry(2000);
  const [searchTerm, setSearchTerm] = useState<string>('');
  const [statusFilter, setStatusFilter] = useState<string>('ALL');
  const [showColumnsMenu, setShowColumnsMenu] = useState<boolean>(false);

  const [columns, setColumns] = useState<ColumnDef[]>([
    { key: 'id', label: 'Packet ID', visible: true },
    { key: 'vehicleNo', label: 'Vehicle No', visible: true },
    { key: 'imei', label: 'IMEI', visible: true },
    { key: 'status', label: 'Status', visible: true },
    { key: 'speed', label: 'Speed', visible: true },
    { key: 'coordinates', label: 'Coordinates (Lat, Lng)', visible: true },
    { key: 'heading', label: 'Heading', visible: true },
    { key: 'satellites', label: 'Satellites', visible: true },
    { key: 'altitude', label: 'Altitude', visible: true },
    { key: 'operator', label: 'Operator', visible: true },
    { key: 'packetTime', label: 'Device Packet Time', visible: true },
    { key: 'createdAt', label: 'Server Ingested Time', visible: true },
  ]);

  const filteredTelemetry = useMemo(() => {
    return recentTelemetry.filter((item) => {
      const vNo = (item.vehicleNo || '').toLowerCase();
      const imei = (item.imei || '').toLowerCase();
      const op = (item.operator || '').toLowerCase();
      const idStr = item.id ? item.id.toString() : '';
      const sTerm = searchTerm.toLowerCase().trim();

      const matchesSearch =
        !sTerm ||
        vNo.includes(sTerm) ||
        imei.includes(sTerm) ||
        op.includes(sTerm) ||
        idStr.includes(sTerm);

      const isMoving = (item.speed || 0) > 2;
      const matchesStatus =
        statusFilter === 'ALL' ||
        (statusFilter === 'MOVING' && isMoving) ||
        (statusFilter === 'IDLE' && !isMoving);

      return matchesSearch && matchesStatus;
    });
  }, [recentTelemetry, searchTerm, statusFilter]);

  const toggleColumn = (key: string) => {
    setColumns((prev) =>
      prev.map((c) => (c.key === key ? { ...c, visible: !c.visible } : c))
    );
  };

  const handleExportCSV = () => {
    const visibleCols = columns.filter((c) => c.visible);
    const headers = visibleCols.map((c) => c.label);

    const rows = filteredTelemetry.map((item) => {
      return visibleCols.map((c) => {
        switch (c.key) {
          case 'id':
            return item.id ?? '';
          case 'vehicleNo':
            return item.vehicleNo ?? '';
          case 'imei':
            return item.imei ?? '';
          case 'status':
            return (item.speed || 0) > 2 ? 'MOVING' : 'IDLE';
          case 'speed':
            return `${(item.speed || 0).toFixed(1)} km/h`;
          case 'coordinates':
            return `${item.latitude?.toFixed(5) || 0}, ${item.longitude?.toFixed(5) || 0}`;
          case 'heading':
            return `${(item.heading || 0).toFixed(1)}°`;
          case 'satellites':
            return item.satellites ?? 24;
          case 'altitude':
            return `${(item.altitude || 0).toFixed(2)} m`;
          case 'operator':
            return (item.operator || 'AIRTEL').toUpperCase();
          case 'packetTime':
            return formatPacketDateTime(item.packetDate, item.packetTime, item.createdAt);
          case 'createdAt':
            return item.createdAt || 'N/A';
          default:
            return '';
        }
      });
    });

    const csvContent =
      'data:text/csv;charset=utf-8,' +
      [headers.join(','), ...rows.map((e) => e.join(','))].join('\n');

    const encodedUri = encodeURI(csvContent);
    const link = document.createElement('a');
    link.setAttribute('href', encodedUri);
    link.setAttribute(
      'download',
      `rajmines_telemetry_recent_all_${new Date().toISOString().slice(0, 10)}.csv`
    );
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  };

  const handleRowClick = (item: VehicleTelemetryViewDto) => {
    if (item.vehicleNo) {
      navigate(`${ROUTES.MAP}?vehicle=${item.vehicleNo}`);
    }
  };

  const isColumnVisible = (key: string) => {
    return columns.find((c) => c.key === key)?.visible ?? true;
  };

  return (
    <div className="bg-white dark:bg-[#0a192f] rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-2xs overflow-hidden flex flex-col min-h-[calc(100vh-6.5rem)]">
      {/* Top Filter & Action Bar */}
      <div className="p-4 md:p-5 border-b border-slate-100 dark:border-slate-800 flex flex-wrap items-center justify-between gap-3 bg-white dark:bg-[#0a192f]">
        {/* Left: Status Filter & Search Input */}
        <div className="flex flex-wrap items-center gap-3 flex-1 min-w-[280px]">
          {/* Status Dropdown */}
          <div className="relative">
            <select
              value={statusFilter}
              onChange={(e) => setStatusFilter(e.target.value)}
              className="appearance-none bg-white dark:bg-[#0c1e38] border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 text-xs font-medium rounded-xl pl-3.5 pr-8 py-2.5 hover:border-slate-300 dark:hover:border-slate-600 focus:outline-none focus:border-cyan-600 transition shadow-2xs cursor-pointer"
            >
              <option value="ALL">All Packets ({recentTelemetry.length})</option>
              <option value="MOVING">Moving (&gt; 2 km/h)</option>
              <option value="IDLE">Idle / Stopped (≤ 2 km/h)</option>
            </select>
            <ChevronDown className="w-3.5 h-3.5 text-slate-400 absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none" />
          </div>

          {/* Search Box */}
          <div className="relative flex-1 max-w-md">
            <Search className="w-3.5 h-3.5 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" />
            <input
              type="text"
              placeholder="Search by Vehicle No, IMEI, Operator, ID..."
              value={searchTerm}
              onChange={(e) => setSearchTerm(e.target.value)}
              className="w-full bg-white dark:bg-[#0c1e38] border border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-500 text-xs rounded-xl pl-9 pr-8 py-2.5 hover:border-slate-300 dark:hover:border-slate-600 focus:outline-none focus:border-cyan-600 transition shadow-2xs"
            />
            {searchTerm && (
              <button
                onClick={() => setSearchTerm('')}
                className="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 text-xs cursor-pointer"
              >
                ×
              </button>
            )}
          </div>
        </div>

        {/* Right: Live Connection Ping, Export CSV & Columns Dropdown */}
        <div className="flex items-center gap-2.5">
          {/* Live Telemetry Stream Indicator */}
          <div className="flex items-center gap-2 px-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-[#0c1e38] text-[11px]">
            <Radio className={`w-3.5 h-3.5 ${isLiveConnected ? 'text-emerald-500 animate-pulse' : 'text-amber-500'}`} />
            <span className="font-semibold text-slate-700 dark:text-slate-200">
              {isLiveConnected ? 'Live Telemetry Stream' : 'Syncing Telemetry'}
            </span>
            {lastSyncTime && (
              <span className="font-mono text-slate-400 dark:text-slate-400 text-[10px]">
                {lastSyncTime}
              </span>
            )}
          </div>

          <button
            onClick={handleExportCSV}
            className="flex items-center gap-2 px-4 py-2 bg-white dark:bg-[#0c1e38] border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 text-xs font-medium rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition shadow-2xs cursor-pointer"
          >
            <Download className="w-4 h-4 text-slate-600 dark:text-slate-300" />
            <span>Export CSV</span>
          </button>

          {/* Columns Selector Dropdown */}
          <div className="relative">
            <button
              onClick={() => setShowColumnsMenu((prev) => !prev)}
              className="flex items-center gap-2 px-4 py-2 bg-white dark:bg-[#0c1e38] border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 text-xs font-medium rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition shadow-2xs cursor-pointer"
            >
              <span>Columns</span>
              <ChevronDown className="w-3.5 h-3.5 text-slate-400" />
            </button>

            {showColumnsMenu && (
              <div className="absolute right-0 mt-2 w-52 bg-white dark:bg-[#0c1e38] border border-slate-200 dark:border-slate-700 rounded-xl shadow-xl z-50 p-2 text-xs">
                <div className="px-2 py-1 text-[10px] font-bold text-slate-400 uppercase tracking-wider border-b border-slate-100 dark:border-slate-700">
                  Toggle Columns
                </div>
                <div className="py-1 max-h-64 overflow-y-auto space-y-1">
                  {columns.map((c) => (
                    <button
                      key={c.key}
                      onClick={() => toggleColumn(c.key)}
                      className="w-full flex items-center justify-between px-2 py-1.5 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800 text-left text-slate-700 dark:text-slate-200 cursor-pointer"
                    >
                      <span>{c.label}</span>
                      {c.visible && <Check className="w-3.5 h-3.5 text-cyan-600 dark:text-cyan-400" />}
                    </button>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      </div>

      {/* Main Table View */}
      <div className="flex-1 overflow-x-auto">
        <table className="w-full text-left border-collapse">
          <thead>
            <tr className="border-b border-slate-100 dark:border-slate-800 bg-white dark:bg-[#0a192f] text-[12px] font-semibold text-slate-700 dark:text-slate-300">
              {isColumnVisible('id') && <th className="py-3.5 px-4 font-semibold">Packet ID</th>}
              {isColumnVisible('vehicleNo') && <th className="py-3.5 px-4 font-semibold">Vehicle No</th>}
              {isColumnVisible('imei') && <th className="py-3.5 px-4 font-semibold">IMEI</th>}
              {isColumnVisible('status') && <th className="py-3.5 px-4 font-semibold">Status</th>}
              {isColumnVisible('speed') && <th className="py-3.5 px-4 font-semibold">Speed</th>}
              {isColumnVisible('coordinates') && <th className="py-3.5 px-4 font-semibold">Coordinates (Lat, Lng)</th>}
              {isColumnVisible('heading') && <th className="py-3.5 px-4 font-semibold">Heading</th>}
              {isColumnVisible('satellites') && <th className="py-3.5 px-4 font-semibold">Satellites</th>}
              {isColumnVisible('altitude') && <th className="py-3.5 px-4 font-semibold">Altitude</th>}
              {isColumnVisible('operator') && <th className="py-3.5 px-4 font-semibold">Operator</th>}
              {isColumnVisible('packetTime') && <th className="py-3.5 px-4 font-semibold">Packet Time</th>}
              {isColumnVisible('createdAt') && <th className="py-3.5 px-4 font-semibold">Ingested Time</th>}
              <th className="py-3.5 px-4 font-semibold text-right">Action</th>
            </tr>
          </thead>
          <tbody className="divide-y divide-slate-100 dark:divide-slate-800 text-xs text-slate-700 dark:text-slate-300 font-mono">
            {isLoading && filteredTelemetry.length === 0 ? (
              <tr>
                <td colSpan={13} className="text-center py-12 text-slate-400">
                  <div className="flex flex-col items-center justify-center gap-2">
                    <Radio className="w-6 h-6 text-cyan-600 animate-pulse" />
                    <span>Loading continuous telemetry stream from Spring Boot API...</span>
                  </div>
                </td>
              </tr>
            ) : filteredTelemetry.length === 0 ? (
              <tr>
                <td colSpan={13} className="text-center py-12 text-slate-400">
                  No telemetry packets matching current filter.
                </td>
              </tr>
            ) : (
              filteredTelemetry.map((item, index) => {
                const isMoving = (item.speed || 0) > 2;

                return (
                  <tr
                    key={item.id || `${item.vehicleNo}-${index}`}
                    onClick={() => handleRowClick(item)}
                    className="hover:bg-slate-50/90 dark:hover:bg-slate-800/60 cursor-pointer transition"
                  >
                    {/* Packet ID */}
                    {isColumnVisible('id') && (
                      <td className="py-3 px-4 font-bold text-slate-600 dark:text-slate-400">
                        #{item.id || '-'}
                      </td>
                    )}

                    {/* Vehicle No */}
                    {isColumnVisible('vehicleNo') && (
                      <td className="py-3 px-4 font-bold text-slate-900 dark:text-slate-100 font-sans">
                        <span className="flex items-center gap-1.5">
                          <span className={`w-2 h-2 rounded-full ${isMoving ? 'bg-emerald-500 animate-pulse' : 'bg-amber-400'}`}></span>
                          {item.vehicleNo}
                        </span>
                      </td>
                    )}

                    {/* IMEI */}
                    {isColumnVisible('imei') && (
                      <td className="py-3 px-4 text-slate-600 dark:text-slate-400 text-[11px]">
                        {item.imei}
                      </td>
                    )}

                    {/* Status Pill */}
                    {isColumnVisible('status') && (
                      <td className="py-3 px-4 font-sans">
                        <span
                          className={`inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold tracking-wide uppercase ${
                            isMoving
                              ? 'bg-[#dcfce7] dark:bg-emerald-950/60 text-[#16a34a] dark:text-emerald-300'
                              : 'bg-[#fef3c7] dark:bg-amber-950/60 text-[#b45309] dark:text-amber-300'
                          }`}
                        >
                          {isMoving ? 'MOVING' : 'IDLE'}
                        </span>
                      </td>
                    )}

                    {/* Speed */}
                    {isColumnVisible('speed') && (
                      <td className="py-3 px-4 font-semibold text-slate-800 dark:text-slate-200">
                        {(item.speed || 0).toFixed(1)} km/h
                      </td>
                    )}

                    {/* Coordinates */}
                    {isColumnVisible('coordinates') && (
                      <td className="py-3 px-4 text-slate-600 dark:text-slate-300 text-[11px]">
                        {item.latitude?.toFixed(5)}, {item.longitude?.toFixed(5)}
                      </td>
                    )}

                    {/* Heading */}
                    {isColumnVisible('heading') && (
                      <td className="py-3 px-4 text-slate-700 dark:text-slate-300">
                        <div className="flex items-center gap-1.5">
                          <Navigation
                            className="w-3 h-3 text-cyan-600 dark:text-cyan-400 transition-transform"
                            style={{ transform: `rotate(${item.heading || 0}deg)` }}
                          />
                          <span>{(item.heading || 0).toFixed(1)}°</span>
                        </div>
                      </td>
                    )}

                    {/* Satellites */}
                    {isColumnVisible('satellites') && (
                      <td className="py-3 px-4 text-slate-700 dark:text-slate-300">
                        {item.satellites ?? 24} sats
                      </td>
                    )}

                    {/* Altitude */}
                    {isColumnVisible('altitude') && (
                      <td className="py-3 px-4 text-slate-700 dark:text-slate-300">
                        {(item.altitude || 0).toFixed(2)} m
                      </td>
                    )}

                    {/* Operator */}
                    {isColumnVisible('operator') && (
                      <td className="py-3 px-4 font-sans">
                        <span className="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-[10px] font-mono font-bold uppercase text-slate-700 dark:text-slate-300">
                          {item.operator || 'AIRTEL'}
                        </span>
                      </td>
                    )}

                    {/* Packet Time */}
                    {isColumnVisible('packetTime') && (
                      <td className="py-3 px-4 text-slate-600 dark:text-slate-400 text-[11px]">
                        {formatPacketDateTime(item.packetDate, item.packetTime, item.createdAt)}
                      </td>
                    )}

                    {/* Ingested Time */}
                    {isColumnVisible('createdAt') && (
                      <td className="py-3 px-4 text-slate-600 dark:text-slate-400 text-[11px]">
                        {formatCreatedAt(item.createdAt)}
                      </td>
                    )}

                    {/* Action: Track on Map */}
                    <td className="py-3 px-4 text-right font-sans">
                      <button
                        onClick={(e) => {
                          e.stopPropagation();
                          handleRowClick(item);
                        }}
                        className="inline-flex items-center gap-1 px-2.5 py-1 text-[11px] font-semibold text-cyan-700 dark:text-cyan-400 bg-cyan-50 dark:bg-cyan-950/50 hover:bg-cyan-100 dark:hover:bg-cyan-900/60 rounded-lg transition cursor-pointer"
                        title="View on Map"
                      >
                        <span>Track</span>
                        <ExternalLink className="w-3 h-3" />
                      </button>
                    </td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>
    </div>
  );
};

export default ListView;
